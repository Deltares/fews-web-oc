import { describe, it, expect } from 'vitest'
import { createDateTimes } from './dataFromResources'
import type { Series } from '../timeseries/timeSeries'

describe('createDateTimes', () => {
  it('should return an empty array if dataResources is not provided', () => {
    const result = createDateTimes([], {})
    expect(result).toEqual([])
  })

  it('should return an array of unique dates from the data in the chart series', () => {
    const seriesRecord: Record<string, Series> = {
      resource1: {
        data: [{ x: new Date('2023-01-01') }, { x: new Date('2023-01-02') }],
      },
      resource2: {
        data: [{ x: new Date('2023-01-01') }, { x: new Date('2023-01-03') }],
      },
    }
    const dataResources = ['resource1', 'resource2']
    const result = createDateTimes(dataResources, seriesRecord)
    expect(result).toEqual([
      new Date('2023-01-01'),
      new Date('2023-01-02'),
      new Date('2023-01-03'),
    ])
  })

  it('should return sorted unique dates', () => {
    const seriesRecord: Record<string, Series> = {
      resource1: {
        data: [{ x: new Date('2023-01-02') }, { x: new Date('2023-01-01') }],
      },
      resource2: {
        data: [{ x: new Date('2023-01-03') }, { x: new Date('2023-01-01') }],
      },
    }
    const dataResources = ['resource1', 'resource2']
    const result = createDateTimes(dataResources, seriesRecord)
    expect(result).toEqual([
      new Date('2023-01-01'),
      new Date('2023-01-02'),
      new Date('2023-01-03'),
    ])
  })

  it('should handle series with no data', () => {
    const seriesRecord: Record<string, Series> = {
      resource1: {
        data: [],
      },
      resource2: {
        data: [{ x: new Date('2023-01-01') }],
      },
    }
    const dataResources = ['resource1', 'resource2']
    const result = createDateTimes(dataResources, seriesRecord)
    expect(result).toEqual([new Date('2023-01-01')])
  })
})
