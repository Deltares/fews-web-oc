{
  "name": "fews-weboc",
  "private": true,
  "version": "1.5.0-rc.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --port 5172 --strictPort --mode e2e",
    "compile-schemas": "node --experimental-strip-types scripts/compile-schemas.ts",
    "build": "vue-tsc && vite build",
    "build:deltares": "vue-tsc && env-cmd -f deltares.env vite build",
    "build:weboc": "vue-tsc && vite build --base=/weboc/",
    "build:e2e": "vue-tsc && vite build --mode e2e",
    "preview": "vite preview",
    "preview:e2e": "vite preview --port 5172 --strictPort --mode e2e",
    "test:unit": "vitest run",
    "test:dev": "vitest",
    "test:component": "playwright test -c playwright-ct.config.ts",
    "test:e2e": "playwright test -c playwright-e2e.config.ts",
    "lint": "npm run prettier",
    "prettier": "prettier . --check",
    "format": "prettier .  --write",
    "sonar": "sonar-scanner -Dsonar.host.url=$SONAR_URL -Dsonar.login=$SONAR_TOKEN -Dsonar.projectKey=$SONAR_KEY -Dsonar.projectName='Delft-FEWS Web OC'"
  },
